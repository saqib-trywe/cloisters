{:paths ["src" "resources"]
 :deps {org.clojure/clojure {:mvn/version "1.12.6"}
        com.github.seancorfield/next.jdbc {:mvn/version "1.4.72"}
        com.github.seancorfield/honeysql {:mvn/version "2.8.85"}
        org.xerial/sqlite-jdbc {:mvn/version "3.53.4.0"}
        com.zaxxer/HikariCP {:mvn/version "7.1.0"}
        org.slf4j/slf4j-simple {:mvn/version "2.0.20"}}
 :aliases
 {:run {:main-opts ["-m" "cloisters.main"]
        :jvm-opts ["--enable-native-access=ALL-UNNAMED"]}
  :test {:extra-paths ["test"]
         :extra-deps {io.github.cognitect-labs/test-runner {:git/tag "v0.5.1" :git/sha "dfb30dd"}}
         :jvm-opts ["--enable-native-access=ALL-UNNAMED"]
         :main-opts ["-m" "cognitect.test-runner"]
         :exec-fn cognitect.test-runner.api/test}
  :lint {:replace-deps {clj-kondo/clj-kondo {:mvn/version "2026.10.20"}}
         :main-opts ["-m" "clj-kondo.main" "--lint" "src" "test" "cli" "build.clj"]}
  :fmt {:replace-deps {dev.weavejester/cljfmt {:mvn/version "0.16.6"}}
        :main-opts ["-m" "cljfmt.main"]}
  :build {:replace-deps {io.github.clojure/tools.build {:mvn/version "0.10.14"}}
          :ns-default build}}}
